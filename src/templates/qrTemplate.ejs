<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Case and Seized Item Details</title>
    <link rel="stylesheet" href="/styles/itemStyle.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }
        .container {
            background: #ffffff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            max-width: 700px;
            width: 100%;
        }
        h1 {
            text-align: center;
            color: #003366;
        }
        .details {
            margin-top: 20px;
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }
        .detail-label {
            font-weight: bold;
            color: #003366;
        }
        .qr-code {
            text-align: center;
            margin-top: 20px;
        }
        img {
            max-width: 120px;
            height: auto;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            padding: 10px;
            border: 1px solid #ddd;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
            color: #003366;
        }
        @media (max-width: 600px) {
            .container {
                padding: 15px;
                max-width: 90%;
            }
            .detail-row {
                flex-direction: column;
                align-items: start;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Maharashtra Police - Case & Seized Item Details</h1>
        <div class="details">
            <% if (caseData) { %>
                <h2>Case Details</h2>
                <div class="detail-row"><span class="detail-label">Case Number:</span> <span class="detail-value"><%= caseData.case_number || 'N/A' %></span></div>
                <div class="detail-row"><span class="detail-label">Crime Number:</span> <span class="detail-value"><%= caseData.crime_number || 'N/A' %></span></div>
                <div class="detail-row"><span class="detail-label">Description:</span> <span class="detail-value"><%= caseData.case_description || 'N/A' %></span></div>
                <div class="detail-row"><span class="detail-label">Investigating Officer:</span> <span class="detail-value"><%= caseData.investigating_officer || 'N/A' %></span></div>
                <div class="detail-row"><span class="detail-label">Case Status:</span> <span class="detail-value"><%= caseData.case_status || 'N/A' %></span></div>
                <div class="detail-row"><span class="detail-label">Filing Date:</span> <span class="detail-value"><%= caseData.filing_date || 'N/A' %></span></div>
                <div class="qr-code">
                    <h2>QR Code</h2>
                    <% if (caseData.QRbase64) { %>
                        <img src="<%= caseData.QRbase64 %>" alt="QR Code">
                    <% } else { %>
                        <p>QR Code not available.</p>
                    <% } %>
                </div>
            <% } %>
            <% if (caseData.seizedItems && caseData.seizedItems.length > 0) { %>
                <h2>Seized Item Details</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Sr. No.</th>
                            <th>Item Category</th>
                             <th>Description</th>
                             <th>Seized Location</th>
                         </tr>
                    </thead>
                    <tbody>
                        <% caseData.seizedItems.forEach((item, index) => { %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td><%= item.item_category || 'N/A' %></td>
                                 <td><%= item.item_description || 'N/A' %></td>
                                 <td><%= item.seized_location || 'N/A' %></td>
                             </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <p>No seized items available.</p>
            <% } %>
        </div>
    </div>
</body>
</html>