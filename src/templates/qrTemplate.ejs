<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Case and Seized Item Details</title>
    <link rel="stylesheet" href="/styles/itemStyle.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }
        .container {
            background: #ffffff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            max-width: 700px;
            width: 100%;
        }
        h1 {
            text-align: center;
            color: #003366;
        }
        .details {
            margin-top: 20px;
        }
        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }
        .detail-label {
            font-weight: bold;
            color: #003366;
        }
        .qr-code {
            text-align: center;
            margin-top: 20px;
        }
        img {
            max-width: 120px;
            height: auto;
        }
        @media (max-width: 600px) {
            .container {
                padding: 15px;
                max-width: 90%;
            }
            .detail-row {
                flex-direction: column;
                align-items: start;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Maharashtra Police - Case & Seized Item Details</h1>
        <div class="details">
            <% if (caseData) { %>
                <h2>Case Details</h2>
                <div class="detail-row"><span class="detail-label">Case ID:</span> <span class="detail-value"><%= caseData.case_id || 'N/A' %></span></div>
                <div class="detail-row"><span class="detail-label">Case Number:</span> <span class="detail-value"><%= caseData.case_number || 'N/A' %></span></div>
                <div class="detail-row"><span class="detail-label">Description:</span> <span class="detail-value"><%= caseData.case_description || 'N/A' %></span></div>
                <div class="detail-row"><span class="detail-label">Investigating Officer:</span> <span class="detail-value"><%= caseData.investigating_officer || 'N/A' %></span></div>
                <div class="detail-row"><span class="detail-label">Case Status:</span> <span class="detail-value"><%= caseData.case_status || 'N/A' %></span></div>
                <div class="detail-row"><span class="detail-label">Filing Date:</span> <span class="detail-value"><%= caseData.filing_date || 'N/A' %></span></div>
                <div class="detail-row"><span class="detail-label">Region:</span> <span class="detail-value"><%= caseData.region || 'N/A' %></span></div>
                <div class="detail-row"><span class="detail-label">Crime Number:</span> <span class="detail-value"><%= caseData.crime_number || 'N/A' %></span></div>
                <div class="detail-row"><span class="detail-label">Court Order:</span> <span class="detail-value"><%= caseData.court_order || 'N/A' %></span></div>
                <div class="detail-row"><span class="detail-label">Closure Date:</span> <span class="detail-value"><%= caseData.closure_date || 'N/A' %></span></div>
                <div class="qr-code">
                    <h2>QR Code</h2>
                    <% if (caseData.QRbase64) { %>
                        <img src="<%= caseData.QRbase64 %>" alt="QR Code">
                    <% } else { %>
                        <p>QR Code not available.</p>
                    <% } %>
                </div>
            <% } %>
            <% if (caseData.seizedItems && caseData.seizedItems.length > 0) { %>
                <h2>Seized Item Details</h2>
                <% caseData.seizedItems.forEach(item => { %>
                    <div class="detail-row"><span class="detail-label">Item ID:</span> <span class="detail-value"><%= item.case_id || 'N/A' %></span></div>
                    <div class="detail-row"><span class="detail-label">Item Category:</span> <span class="detail-value"><%= item.item_category || 'N/A' %></span></div>
                    <div class="detail-row"><span class="detail-label">Sub Category:</span> <span class="detail-value"><%= item.sub_category || 'N/A' %></span></div>
                    <div class="detail-row"><span class="detail-label">Description:</span> <span class="detail-value"><%= item.item_description || 'N/A' %></span></div>
                    <div class="detail-row"><span class="detail-label">Seized Date:</span> <span class="detail-value"><%= item.seized_date || 'N/A' %></span></div>
                    <div class="detail-row"><span class="detail-label">Seized Location:</span> <span class="detail-value"><%= item.seized_location || 'N/A' %></span></div>
                    <div class="detail-row"><span class="detail-label">Seizing Officer:</span> <span class="detail-value"><%= item.seizing_officer || 'N/A' %></span></div>
                    <div class="detail-row"><span class="detail-label">Current Status:</span> <span class="detail-value"><%= item.current_status || 'N/A' %></span></div>
                    <div class="detail-row"><span class="detail-label">Release Date:</span> <span class="detail-value"><%= item.release_date || 'N/A' %></span></div>
                    <div class="detail-row"><span class="detail-label">Released To:</span> <span class="detail-value"><%= item.released_to || 'N/A' %></span></div>
                    <div class="detail-row"><span class="detail-label">Remarks:</span> <span class="detail-value"><%= item.remarks || 'N/A' %></span></div>
                    <hr> <!-- Separator for each seized item -->
                <% }) %>
            <% } else { %>
                <p>No seized items available.</p>
            <% } %>
            
        </div>
    </div>
</body>
</html>