generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  password        String
  role            Role           @default(USER) // Role-based access (ADMIN or USER)
  policeStationId String?
  policeStation   PoliceStation? @relation(fields: [policeStationId], references: [id])
  cases           CaseReg[]      // One-to-many relationship with cases
  logs            Logs[]  
  createdAt       DateTime       @default(now())
 updatedAt DateTime @updatedAt @default(now())
}

model PoliceStation {
  id        String  @id @default(uuid()) // Unique identifier
  name      String
  region    String
  address   String
  state     String
  district  String
  taluka    String
  createdAt DateTime @default(now())     // Timestamp for record creation
 updatedAt DateTime @updatedAt @default(now())

  users    User[]  // One-to-many relationship with users
    cases    CaseReg[]   // Reverse relation: one police station can have many cases
}

model CaseReg {
  case_id               BigInt  @id @default(autoincrement())
  case_number           String  @unique
  case_description      String
  policeStationId       String
  policeStation         PoliceStation @relation(fields: [policeStationId], references: [id])
  investigating_officer String  @db.VarChar(100)
  case_status           CaseStatus
  filing_date           DateTime
  closure_date          DateTime?

  userId                String
  user                  User @relation(fields: [userId], references: [id])

  // Relationships
  seizedItems           SeizedItems[]
  courtCases            Court[]

  createdAt             DateTime @default(now())
 updatedAt DateTime @updatedAt @default(now())
}

model SeizedItems {
  item_id          BigInt    @id @default(autoincrement())
  case_id          BigInt

  item_category    ItemCategory
  sub_category     String    @db.VarChar(50)
  item_description String
  seized_date      DateTime
  seized_location  String    @db.VarChar(255)
  seizing_officer  String    @db.VarChar(100)
  current_status   ItemStatus
  release_date     DateTime?
  released_to      String?   @db.VarChar(100)
  remarks          String?

  // Jewelry Fields
  jewelryType       String?
  jewelryWeight     Float?
  purityLevel       String?
  quantity          Int?
  weight            Float?
  estimatedValue    Float?

  // Electronics & Vehicles
  brandModel        String?
  serialNumber      String?
  imeiNumber        String?

  vehicleType       String?
  registrationNumber String?
  chassisNumber     String?
  engineNumber      String?
  vehicleOwner      String?

  // Documents
  documentType      String?
  documentNumber    String?
  issuingAuthority  String?
  forgeryDetected   Boolean?

  // Currency
  currencyType      String?
  totalAmount       Float?
  counterfeit       Boolean?

  // Drugs & Weapons
  drugType          String?
  drugQuantity      Float?
  weaponType        String?
  weaponModel       String?

  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  // Relationships
  images           Image[]
  vehicleDocuments VehicleDocument[]
  serialNumbers    SerialNumber[]

  // Foreign key linking to Case
  case             CaseReg  @relation(fields: [case_id], references: [case_id], onDelete: Cascade)
}

model Court {
  id                     BigInt   @id @default(autoincrement())
  order_number           String   @unique
  court_type             String
  court_name             String
  courtCaseNumber        String   @unique
  court_policestation_info String
  court_order_info       String
  case_id                BigInt   // Foreign key to Case
  hearing_date           DateTime?
  verdict_date           DateTime?
  verdict_summary        String?
  judge_name             String?
  status                 CourtStatus

  createdAt              DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  // Relation to Case (Many court records can belong to one case)
  case                   CaseReg @relation(fields: [case_id], references: [case_id], onDelete: Cascade)
}

// Supporting Models
model Image {
  id       BigInt  @id @default(autoincrement())
  item_id  BigInt
  url      String  @db.Text

  // Relation to Seized_Items
  seizedItem SeizedItems @relation(fields: [item_id], references: [item_id], onDelete: Cascade)
}

model VehicleDocument {
  id       BigInt  @id @default(autoincrement())
  item_id  BigInt
  doc_url  String  @db.Text

  // Relation to Seized_Items
  seizedItem SeizedItems @relation(fields: [item_id], references: [item_id], onDelete: Cascade)
}

model SerialNumber {
  id       BigInt  @id @default(autoincrement())
  item_id  BigInt
  serial   String

  // Relation to Seized_Items
  seizedItem SeizedItems @relation(fields: [item_id], references: [item_id], onDelete: Cascade)
}

model Logs {
  id           BigInt  @id @default(autoincrement())
  entityType   EntityType  // Case, SeizedItem, Court
  entityId     BigInt      // ID of the related entity
  actionType   ActionType  // Created, Updated, Deleted
  changedData  Json?       // Stores old/new data in JSON format
  userId       String      // Who performed the action
  user         User        @relation(fields: [userId], references: [id])
  timestamp    DateTime    @default(now())
}

// Enums for Logs
enum EntityType {
  CaseReg
  SeizedItem
  Court
}

enum ActionType {
  Created
  Updated
  Deleted
}



// Enums
enum ItemCategory {
  Jewelry
  Vehicle
  Electronics
  Mobile
  Documents
  Drugs
  Other
}

enum ItemStatus {
  InCustody
  Released
  Disposed
  Transferred
}

enum CourtStatus {
  Pending
  Closed
  UnderAppeal
}

enum CaseStatus {
  Open
  Closed
  Investigation
}

enum Role {
  ADMIN
  USER
}
