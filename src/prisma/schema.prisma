generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  password        String
  role            Role           @default(USER) // Role-based access (ADMIN or USER)
  policeStationId String?
  designation     String         @default("default_designation")
  mobile          String         @default("000-000-0000")
  policeStation   PoliceStation? @relation(fields: [policeStationId], references: [id])
  cases           CaseReg[] // One-to-many relationship with cases
  logs            Logs[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
}

model PoliceStation {
  id        String   @id @default(uuid()) // Unique identifier
  name      String
  region    String
  address   String
  state     String
  district  String
  taluka    String
  createdAt DateTime @default(now()) // Timestamp for record creation
  updatedAt DateTime @default(now()) @updatedAt

  users User[] // One-to-many relationship with users
  cases CaseReg[] // Reverse relation: one police station can have many cases
}

model CaseReg {
  case_id               String        @id @default(uuid())
  case_number           String
  case_description      String        @db.Text
  policeStationId       String
  policeStation         PoliceStation @relation(fields: [policeStationId], references: [id])
  investigating_officer String        @db.VarChar(100)
  case_status           String        @default("Open")
  filing_date           String
  closure_date          String?
  region                String        @default("default_region")
  year                  Int           @default(2025)
  userId                String
  user                  User          @relation(fields: [userId], references: [id])
  acts                  Json?
  court_order           String        @default("Pending")
  crime_number          String        @default("Unknown")
  guilty_details        String        @db.Text     
  bhags                 Json?         @default("[]")
  images                Json?         @default("[]")
  seized_date           String        @default("Not Specified")
  acquire_date          String        @default("Not Specified")
  QRbase64  String?  @db.LongText        
  // Timestamps
  // Relationships
  seizedItems           SeizedItems[]
  courtCases            Court[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model SeizedItems {
  item_id          String     @id @default(uuid())
  case_id          String
  item_category    String
  sub_category     String?     @db.VarChar(50)
  item_description String?     @db.Text
  seized_date      String
  seized_location  String     @db.VarChar(255)
  seizing_officer  String     @db.VarChar(100)
  current_status   String?     @default("InCustody")
  release_date     String?
  released_to      String?    @db.VarChar(100)
  remarks          String?    
  Bhag             String?    @default("Not Specified")
  depositDate     String?     @default("Not Specified")
  fromWhomReceived        String?    @default("Not Specified")
  weight           String?     @default("Not Specified")
  NoOfItems        String?    @default("Not Specified")
  price            String?    @default("Not Specified")
  itemStateDescription String  @db.Text 
  QRbase64  String?  @db.LongText    
  images           Json?    @default("[]")


  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relationships

  // Foreign key linking to Case
  case CaseReg @relation(fields: [case_id], references: [case_id], onDelete: Cascade)
}

model Court {
  id                       String      @id @default(uuid())
  order_number             String
  court_type               String
  court_name               String
  courtCaseNumber          String
  court_policestation_info String
  court_order_info         String
  case_id                  String // Foreign key to Case
  hearing_date             String?
  verdict_date             String?
  verdict_summary          String?
  judge_name               String?
  status                   String?     @default("Pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relation to Case (Many court records can belong to one case)
  case CaseReg @relation(fields: [case_id], references: [case_id], onDelete: Cascade)
}

// Supporting Models
model QR {
  id              String @id @default(uuid())
  seizedItem_Name String
  case_id         String
  qr_base64       String @db.LongText
}



model Logs {
  id          String     @id @default(uuid())
  entityType  EntityType // Case, SeizedItem, Court
  entityId    String? // ID of the related entity
  actionType  ActionType // Created, Updated, Deleted
  changedData Json? // Stores old/new data in JSON format
  userId      String // Who performed the action
  user        User       @relation(fields: [userId], references: [id])
  timestamp   DateTime   @default(now())
}

// Enums for Logs
enum EntityType {
  CaseReg
  SeizedItem
  Court
}

enum ActionType {
  Created
  Updated
  Deleted
}

// Enums
enum ItemCategory {
  Jewelry
  Vehicle
  Electronics
  Mobile
  Documents
  Drugs
  Other
}

enum ItemStatus {
  InCustody
  Released
  Disposed
  Transferred
}

enum CourtStatus {
  Pending
  Closed
  UnderAppeal
}

enum CaseStatus {
  Open
  Closed
  Investigation
}

enum Role {
  ADMIN
  USER
}
